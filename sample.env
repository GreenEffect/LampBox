# ==============================================================================
# LAMPBOX - Configuration File
# ==============================================================================
# Copy this file to .env and modify according to your needs
# Each project should have its own .env file with unique ports/names

# ==============================================================================
# PROJECT CONFIGURATION
# ==============================================================================

# Project name - used for container names and network
# Must be unique if you run multiple projects simultaneously
COMPOSE_PROJECT_NAME=lamp

# User/Group IDs for file permissions
# Linux/Mac: Set to your user ID (run 'id -u' and 'id -g' to find yours)
# Windows: Leave as 1000 (permissions handled differently on Windows)
# Note: These values are only used on Linux/Mac, ignored on Windows
USER_ID=1000
GROUP_ID=1000

# ==============================================================================
# ENVIRONMENT
# ==============================================================================

# development: PHP errors displayed, Xdebug in develop mode, phpMyAdmin open
#              (config/php/php.ini)
# production:  errors logged but not displayed, Xdebug off, PHP version hidden,
#              phpMyAdmin denied unless PHPMYADMIN_REQUIRE allows it
#              (config/php/php-production.ini, docker-compose.production.yml)
LAMPBOX_ENV=development

# lamp.sh selects the compose files by itself. If you run 'docker compose'
# directly, list them here so the production (and proxy) overrides apply.
# Separator is ':' (Linux/macOS) or ';' (Windows), e.g.:
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml:docker-compose.production.yml

# ==============================================================================
# ACCESS MODE CONFIGURATION
# ==============================================================================

# Enable reverse proxy mode (shared Traefik proxy)
# - false: Access via http://localhost:HTTP_PORT (direct port access)
# - true:  Access via https://PROJECT_DOMAIN (domain-based access via Traefik)
#
# In proxy mode a single shared Traefik instance owns ports 80/443 and routes
# every project by its domain, so you can run many projects in parallel without
# port conflicts. Start it once with: ./lamp.sh proxy-up
USE_REVERSE_PROXY=false

# Domain name for reverse proxy mode (only used if USE_REVERSE_PROXY=true)
# Must be unique per project. Don't forget to add it to your hosts file:
# 127.0.0.1    myproject.local
PROJECT_DOMAIN=myproject.local

# ==============================================================================
# PORT CONFIGURATION (only used if USE_REVERSE_PROXY=false)
# ==============================================================================
# In reverse proxy mode these ports are IGNORED: Traefik owns 80/443 and routes
# by domain. They only matter in direct port mode (USE_REVERSE_PROXY=false).

# HTTP port for Apache webserver
# Change this if running multiple projects simultaneously in direct port mode
HTTP_PORT=8080

# HTTPS port for Apache webserver
HTTPS_PORT=8443

# MySQL/MariaDB port on the HOST (optional) - empty by default
#
# Empty = the database is NOT published on the host. This is the safe default:
# it lets several projects run in parallel without fighting over port 3306.
# Your app always reaches its own database from inside the containers at
# ${COMPOSE_PROJECT_NAME}-database:3306, and phpMyAdmin keeps working.
#
# Set a port ONLY if you need to connect from the host with a GUI client
# (TablePlus, DBeaver, MySQL Workbench...). It is NOT covered by the reverse
# proxy, so give each project a UNIQUE value: 3306, 3307, 3308, ...
MYSQL_PORT=

# ==============================================================================
# PHP CONFIGURATION
# ==============================================================================

# PHP Version
# Possible values: php82, php83, php84, php85
PHPVERSION=php83

# Document root on host machine
DOCUMENT_ROOT=./www

# Document root inside Apache container
APACHE_DOCUMENT_ROOT=/var/www/html

# Virtual hosts directory
VHOSTS_DIR=./config/vhosts

# Apache logs directory
APACHE_LOG_DIR=./logs/apache2

# PHP configuration file
PHP_INI=./config/php/php.ini

# phpMyAdmin configuration file
PHPMYADMIN_CONFIG=./config/phpmyadmin/config.inc.php

# SSL certificates directory (for Apache direct HTTPS)
SSL_DIR=./config/ssl

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Database engine and version
# Possible values: mysql84, mysql97, mariadb1011, mariadb114, mariadb118, mariadb123
# All of them are LTS releases, available for amd64 and arm64 (Apple Silicon)
DATABASE=mysql84

# MySQL initialization scripts directory
# Place .sql, .sql.gz, or .sh files here to run on first startup
MYSQL_INITDB_DIR=./config/initdb

# MySQL data directory (persistent storage)
# Default uses a version-specific folder to prevent incompatible engine data reuse
MYSQL_DATA_DIR=./data/mysql-${DATABASE}

# MySQL logs directory
MYSQL_LOG_DIR=./logs/mysql-${DATABASE}

# ==============================================================================
# DATABASE CREDENTIALS
# ==============================================================================
# Docker Compose expands '$' in .env values: an unquoted password such as
# abc$xyz becomes 'abc' (with a "variable is not set" warning). Put values
# containing '$' between single quotes, which also suits lamp.sh:
#   MYSQL_PASSWORD='abc$xyz'
# Avoid single quotes inside such values.

# MySQL root password
MYSQL_ROOT_PASSWORD=tiger

# Database name
MYSQL_DATABASE=docker

# Database user (non-root)
MYSQL_USER=docker

# Database user password
MYSQL_PASSWORD=docker

# phpMyAdmin Blowfish secret key (auto-generated by init.sh if empty)
# Must be 32 characters long for security
# Leave empty and init.sh will generate a random one
PHPMYADMIN_BLOWFISH_SECRET=

# Who may open phpMyAdmin (/<COMPOSE_PROJECT_NAME>-mysql): an Apache 'Require'
# rule. Empty = "all granted" in development, "all denied" in production.
# The rule contains spaces: keep the quotes, e.g.
#   PHPMYADMIN_REQUIRE='all denied'
#   PHPMYADMIN_REQUIRE='ip 203.0.113.10 198.51.100.0/24'
# Behind the shared Traefik proxy, the real client IP is checked.
# Root login is always disabled in phpMyAdmin: use MYSQL_USER instead.
PHPMYADMIN_REQUIRE=

# ==============================================================================
# REVERSE PROXY CONFIGURATION (only used if USE_REVERSE_PROXY=true)
# ==============================================================================
# Routing is handled by the shared Traefik stack (traefik/docker-compose.yml).
# Projects attach to this external Docker network so Traefik can reach them.
# The shared TLS certificate lives in traefik/certs/ (see ./lamp.sh ssl).

# Shared Docker network used by Traefik and every proxied project
PROXY_NETWORK=lampbox_web
