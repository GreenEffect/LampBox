# Environment
.env
.env.local
.env.*.local

# Data directories
data/mysql/*
!data/mysql/.gitkeep
data/db-dumps/
logs/*
!logs/.gitkeep
!logs/apache2/.gitkeep
!logs/mysql/.gitkeep

# SSL Certificates (generated)
config/ssl/*.pem
config/ssl/*.crt
config/ssl/*.key
traefik/certs/*.pem
traefik/certs/*.crt
traefik/certs/*.key
!traefik/certs/.gitkeep

# Backups
*.sql
*.sql.gz
backup_*.sql

# IDE
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.log
*.bak
*.cache

# Node modules (if any)
node_modules/
npm-debug.log*

# Composer vendor (if needed)
vendor/

# Build artifacts
buildtest/
*.tar.gz
*.zip

# Documentation temp files
*.md~
*.txt~
